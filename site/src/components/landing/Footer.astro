---
import Mark from "./Mark.astro";
import { cfg } from "../../lib/source";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="foot">
  <div class="wrap foot__in">
    <div class="foot__brand">
      <p class="brand"><Mark size={26} /><span>{cfg.name}</span></p>
      <p class="foot__note">{cfg.footnote}</p>
    </div>
    <nav class="foot__nav" aria-label="Footer">
      <a href={`${base}/guide/`}>Guide</a>
      <a href={`${base}/guide/deployment`}>Self-host</a>
      <a href={`${base}/guide/spec`}>Spec</a>
      <a href={cfg.repoUrl}>Source</a>
      <a href={`${cfg.repoUrl}/blob/${cfg.branch}/LICENSE`}>MIT licence</a>
    </nav>
    <p class="foot__thanks"><span lang="hi">शुक्रिया</span> <span>Thank you for reading.</span></p>
  </div>
</footer>

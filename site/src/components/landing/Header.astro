---
import Mark from "./Mark.astro";
import { cfg } from "../../lib/source";
import { DEMO_URL } from "./data";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="top">
  <div class="wrap top__in">
    <a class="brand" href={`${base}/`} aria-label={`${cfg.name}, home`}><Mark size={26} /><span>{cfg.name}</span></a>
    <nav class="top__nav" aria-label="Primary">
      <a href={`${base}/guide/`}>Guide</a>
      <a href={cfg.repoUrl}>Source</a>
    </nav>
    <button class="themebtn" type="button" data-theme-toggle data-mode="system" aria-label="Theme: match system. Switch theme" title="Theme">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <g class="ti ti--system"><circle cx="12" cy="12" r="8"></circle><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none"></path></g>
        <g class="ti ti--light"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"></path></g>
        <g class="ti ti--dark"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"></path></g>
      </svg>
    </button>
    <span class="sr-only" role="status" data-theme-status></span>
    <a class="btn btn--primary btn--sm" href={DEMO_URL}>Try the demo</a>
  </div>
</header>

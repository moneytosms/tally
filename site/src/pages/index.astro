---
import "@fontsource-variable/anek-latin/wdth.css";
import "@fontsource-variable/anek-devanagari/wdth.css";
import "../styles/landing.css";
import Landing from "../layouts/Landing.astro";
import Header from "../components/landing/Header.astro";
import Hero from "../components/landing/Hero.astro";
import Parchi from "../components/landing/Parchi.astro";
import Kolam from "../components/landing/Kolam.astro";
import Standee from "../components/landing/Standee.astro";
import Film from "../components/landing/Film.astro";
import Matchboxes from "../components/landing/Matchboxes.astro";
import Screens from "../components/landing/Screens.astro";
import Import from "../components/landing/Import.astro";
import SelfHost from "../components/landing/SelfHost.astro";
import Footer from "../components/landing/Footer.astro";

const title = "tally: expense splitting that shows its working";
const description =
  "A self-hosted ledger for friends. Exact to the paisa, every suggested transfer explains itself, every edit is undoable. Free to run, invite-only, no ads, no tracking. MIT.";
---

<Landing title={title} description={description}>
  <Header slot="header" />
  <Hero />
  <Parchi />
  <Kolam />
  <Standee />
  <Film />
  <Matchboxes />
  <Screens />
  <Import />
  <SelfHost />
  <Footer slot="footer" />
  <script>
    import "../scripts/landing.ts";
  </script>
</Landing>
